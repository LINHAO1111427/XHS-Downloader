+        return "\n\n".join(parts)
+
+    @staticmethod
+    def _responses_payload(model: str, text: str, data_urls: list[str]) -> dict:
+        content = [{"type": "input_text", "text": text}]
+        content.extend(
+            {"type": "input_image", "image_url": image_url} for image_url in data_urls
+        )
+        return {
