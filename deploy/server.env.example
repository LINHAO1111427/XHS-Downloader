XHS_PUBLIC_HOST=app.example.com
XHS_ALLOWED_HOSTS=app.example.com,localhost,127.0.0.1
XHS_MAX_USERS=10
XHS_MAX_WORKSPACES=12
XHS_MAX_ACTIVE_REQUESTS=12
XHS_AI_CONCURRENCY=4
XHS_MEDIA_CONCURRENCY=1
XHS_MEDIA_QUEUE=10
XHS_PRODUCT_BROWSER_CONCURRENCY=1
XHS_MIN_FREE_MB=2048
# Configure your server-accessible AI endpoint in the admin page after login.
# 127.0.0.1 in a container refers to that container; the local PC relay is separate.
