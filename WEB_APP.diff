+
+<dialog id="settingsDialog">
+    <form method="dialog" class="dialog-shell" id="cookieForm">
+        <div class="dialog-heading"><div><h2>Cookie 设置</h2><p id="cookieState">未配置</p></div><button class="icon-button subtle" value="cancel" aria-label="关闭"><i data-lucide="x"></i></button></div>
+        <label class="url-field" for="cookieInput"><span>小红书网页 Cookie</span><textarea id="cookieInput" rows="5" placeholder="粘贴 Cookie；留空并保存可清除" autocomplete="off"></textarea></label>
+        <div class="dialog-actions"><button class="button secondary" value="cancel">取消</button><button class="button primary" id="saveCookieButton" type="submit"><i data-lucide="save"></i>保存</button></div>
+    </form>
+</dialog>
+
+<dialog id="disclaimerDialog">
+    <form method="dialog" class="dialog-shell compact">
+        <div class="dialog-heading"><div><h2>首次使用确认</h2><p>GNU General Public License v3.0</p></div></div>
+        <p class="dialog-copy">下载任务仅处理你提交的公开链接。继续使用即表示你同意 XHS-Downloader 项目的使用声明。</p>
+        <div class="dialog-actions"><button class="button primary" id="acceptDisclaimerButton" type="button">同意并继续</button></div>
+    </form>
+</dialog>
+
+<div class="toast" id="toast" role="status" aria-live="polite"></div>
+
+<script src="/assets/lucide.min.js"></script>
+<script src="/assets/app.js"></script>
+</body>
+</html>
diff --git a/static/web/styles.css b/static/web/styles.css
new file mode 100644
index 0000000..f983a81
--- /dev/null
+++ b/static/web/styles.css
@@ -0,0 +1,148 @@
+:root {
+    color-scheme: light;
+    --bg: #f6f7f9;
+    --surface: #ffffff;
+    --text: #202124;
+    --muted: #6f737a;
+    --line: #dfe2e6;
+    --line-strong: #c8cdd3;
+    --primary: #d9273e;
+    --primary-hover: #b91f34;
+    --success: #18794e;
+    --success-soft: #e8f5ee;
+    --warning: #9a6700;
+    --warning-soft: #fff7d6;
+    --danger-soft: #fff0f1;
+    --info: #1769aa;
+    --radius: 6px;
+    --shadow: 0 12px 36px rgba(32, 33, 36, 0.14);
+    font-family: Inter, "Segoe UI", "Microsoft YaHei", sans-serif;
+}
+
+* { box-sizing: border-box; }
+body { margin: 0; min-width: 320px; background: var(--bg); color: var(--text); font-size: 14px; }
+button, input, textarea { font: inherit; letter-spacing: 0; }
+button { cursor: pointer; }
+button:disabled { cursor: not-allowed; opacity: .48; }
+
+.app-header {
+    height: 70px;
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    padding: 0 max(22px, calc((100vw - 1160px) / 2));
+    background: var(--surface);
+    border-bottom: 1px solid var(--line);
+    position: sticky;
+    top: 0;
+    z-index: 10;
+}
+.brand, .header-actions, .input-actions, .secondary-actions, .library-actions, .service-status, .quality-badge { display: flex; align-items: center; }
+.brand { gap: 11px; min-width: 0; }
+.brand img { border-radius: var(--radius); flex: 0 0 auto; }
+.brand h1 { margin: 0; font-size: 17px; line-height: 1.25; letter-spacing: 0; }
+.brand p { margin: 3px 0 0; color: var(--muted); font-size: 12px; }
+.header-actions { gap: 8px; }
+.service-status { gap: 7px; color: var(--muted); font-size: 12px; margin-right: 4px; }
+.service-status i { width: 8px; height: 8px; border-radius: 50%; background: #a8adb4; }
+.service-status.online i { background: var(--success); box-shadow: 0 0 0 3px var(--success-soft); }
+.service-status.error i { background: var(--primary); box-shadow: 0 0 0 3px var(--danger-soft); }
+
+main { max-width: 1160px; margin: 0 auto; padding: 24px 22px 54px; }
+.input-band { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 22px; }
+.content-section { padding: 28px 0 0; }
+.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 18px; margin-bottom: 14px; }
+.section-heading h2 { margin: 0; font-size: 16px; line-height: 1.35; letter-spacing: 0; }
+.section-heading p { margin: 4px 0 0; color: var(--muted); font-size: 12px; overflow-wrap: anywhere; }
+.quality-badge { gap: 6px; min-height: 28px; padding: 0 9px; color: var(--success); background: var(--success-soft); border-radius: 4px; font-size: 12px; white-space: nowrap; }
+.quality-badge svg { width: 15px; height: 15px; }
+
+.url-field { display: grid; gap: 8px; color: #3b3e43; font-weight: 600; font-size: 13px; }
+textarea { width: 100%; resize: vertical; min-height: 84px; padding: 12px 13px; color: var(--text); background: #fbfbfc; border: 1px solid var(--line-strong); border-radius: var(--radius); outline: none; line-height: 1.55; }
+textarea:focus, input:focus { border-color: var(--info); box-shadow: 0 0 0 3px rgba(23, 105, 170, .12); }
+.input-actions { justify-content: space-between; gap: 12px; margin-top: 14px; }
+.secondary-actions, .library-actions { gap: 8px; }
+.button, .icon-button { border: 1px solid transparent; border-radius: var(--radius); display: inline-flex; align-items: center; justify-content: center; gap: 7px; min-height: 38px; transition: background-color .16s ease, border-color .16s ease, color .16s ease; }
+.button { padding: 0 14px; font-weight: 600; }
+.button svg, .icon-button svg { width: 17px; height: 17px; }
+.button.primary { color: white; background: var(--primary); border-color: var(--primary); }
+.button.primary:hover { background: var(--primary-hover); border-color: var(--primary-hover); }
+.button.secondary { color: #34373b; background: var(--surface); border-color: var(--line-strong); }
+.button.secondary:hover, .icon-button:hover { background: #f0f2f4; }
+.icon-button { width: 38px; padding: 0; color: #52565c; background: var(--surface); border-color: var(--line); }
+.icon-button.subtle { background: transparent; border-color: transparent; }
+
+.task-list { border-top: 1px solid var(--line); }
+.task-row { display: grid; grid-template-columns: minmax(210px, 1.5fr) minmax(170px, 1fr) 110px 40px; gap: 20px; align-items: center; min-height: 76px; border-bottom: 1px solid var(--line); }
+.task-name { min-width: 0; }
+.task-name strong { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.task-name span, .progress-meta { display: block; margin-top: 5px; color: var(--muted); font-size: 12px; }
+.task-progress { min-width: 0; }
+.progress-track { height: 6px; overflow: hidden; background: #e4e7ea; border-radius: 3px; }
+.progress-bar { height: 100%; width: 0; background: var(--info); border-radius: inherit; transition: width .25s ease; }
+.state-pill { justify-self: start; min-width: 76px; padding: 5px 8px; border-radius: 4px; text-align: center; font-size: 12px; font-weight: 600; background: #eceff2; color: #555a60; }
+.state-pill.processing { background: #e9f3fb; color: var(--info); }
+.state-pill.success { background: var(--success-soft); color: var(--success); }
+.state-pill.failed { background: var(--danger-soft); color: var(--primary); }
+.state-pill.skipped { background: var(--warning-soft); color: var(--warning); }
+
+.library-heading { align-items: flex-end; }
+.search-field { height: 38px; width: 230px; display: flex; align-items: center; gap: 7px; padding: 0 10px; background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--radius); color: var(--muted); }
+.search-field:focus-within { border-color: var(--info); box-shadow: 0 0 0 3px rgba(23, 105, 170, .12); }
+.search-field svg { width: 16px; height: 16px; flex: 0 0 auto; }
+.search-field input { min-width: 0; width: 100%; border: 0; outline: 0; background: transparent; box-shadow: none; }
+.file-table-wrap { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow-x: auto; }
+.file-table { width: 100%; min-width: 760px; border-collapse: collapse; }
+.file-table th { height: 42px; color: var(--muted); background: #f7f8fa; font-size: 12px; font-weight: 600; text-align: left; border-bottom: 1px solid var(--line); }
+.file-table td { height: 54px; border-bottom: 1px solid var(--line); }
+.file-table tbody tr:last-child td { border-bottom: 0; }
+.file-table th, .file-table td { padding: 0 12px; }
+.file-table .select-cell { width: 42px; text-align: center; }
+.file-table .action-cell { width: 54px; text-align: center; }
+.file-name { max-width: 480px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: 600; }
+.file-kind { text-transform: uppercase; color: var(--info); font-size: 12px; font-weight: 700; }
+.file-download { color: var(--primary); }
+.file-download svg { width: 18px; height: 18px; }
+.file-download:hover { color: var(--primary-hover); }
+input[type="checkbox"] { width: 16px; height: 16px; accent-color: var(--primary); }
+
+.empty-state { min-height: 120px; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 9px; color: #969ba2; }
+.empty-state svg { width: 24px; height: 24px; }
+.file-table:not([hidden]) + .empty-state { display: none; }
+.file-table[hidden] + .empty-state { display: flex; }
+
+dialog { width: min(560px, calc(100vw - 30px)); padding: 0; border: 0; border-radius: 8px; box-shadow: var(--shadow); }
+dialog::backdrop { background: rgba(22, 24, 27, .45); }
+.dialog-shell { padding: 22px; }
+.dialog-shell.compact { max-width: 460px; }
+.dialog-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; margin-bottom: 20px; }
+.dialog-heading h2 { margin: 0; font-size: 17px; }
+.dialog-heading p { margin: 4px 0 0; color: var(--muted); font-size: 12px; }
+.dialog-copy { margin: 0; color: #4e5258; line-height: 1.7; }
+.dialog-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 20px; }
+.toast { position: fixed; right: 22px; bottom: 22px; max-width: min(390px, calc(100vw - 44px)); padding: 11px 14px; color: white; background: #30343a; border-radius: var(--radius); box-shadow: var(--shadow); opacity: 0; transform: translateY(8px); pointer-events: none; transition: .2s ease; z-index: 30; }
+.toast.show { opacity: 1; transform: translateY(0); }
+.toast.error { background: #9f1d31; }
+
+@media (max-width: 760px) {
+    .app-header { height: 62px; padding: 0 14px; }
+    .brand img { width: 36px; height: 36px; }
+    .brand h1 { font-size: 15px; }
+    .brand p, .service-status span { display: none; }
+    main { padding: 16px 14px 40px; }
+    .input-band { padding: 16px; }
+    .input-heading, .library-heading { align-items: flex-start; }
+    .library-heading { flex-direction: column; }
+    .library-actions { width: 100%; flex-wrap: wrap; }
+    .search-field { width: 100%; }
+    .task-row { grid-template-columns: minmax(0, 1fr) 76px 38px; gap: 10px; padding: 12px 0; }
+    .task-progress { grid-column: 1 / -1; grid-row: 2; }
+    .state-pill { grid-column: 2; grid-row: 1; }
+    .task-row > .icon-button { grid-column: 3; grid-row: 1; }
+}
+
+@media (max-width: 430px) {
+    .quality-badge { display: none; }
+    .input-actions { align-items: stretch; }
+    .button.primary { flex: 1; }
+}
diff --git a/static/web/app.js b/static/web/app.js
new file mode 100644
index 0000000..eff6b6b
--- /dev/null
+++ b/static/web/app.js
@@ -0,0 +1,322 @@
+const byId = (id) => document.getElementById(id);
+
+const elements = {
+    serviceStatus: byId("serviceStatus"),
+    downloadRoot: byId("downloadRoot"),
+    urlInput: byId("urlInput"),
+    downloadButton: byId("downloadButton"),
+    pasteButton: byId("pasteButton"),
+    clearInputButton: byId("clearInputButton"),
+    taskList: byId("taskList"),
+    taskSummary: byId("taskSummary"),
+    clearTasksButton: byId("clearTasksButton"),
+    fileList: byId("fileList"),
+    fileEmpty: byId("fileEmpty"),
+    fileSearch: byId("fileSearch"),
+    librarySummary: byId("librarySummary"),
+    selectAllFiles: byId("selectAllFiles"),
+    archiveButton: byId("archiveButton"),
+    refreshLibraryButton: byId("refreshLibraryButton"),
+    openFolderButton: byId("openFolderButton"),
+    settingsButton: byId("settingsButton"),
+    settingsDialog: byId("settingsDialog"),
+    cookieForm: byId("cookieForm"),
+    cookieInput: byId("cookieInput"),
+    cookieState: byId("cookieState"),
+    disclaimerDialog: byId("disclaimerDialog"),
+    acceptDisclaimerButton: byId("acceptDisclaimerButton"),
+    toast: byId("toast"),
+};
+
+let currentState = null;
+let libraryItems = [];
+let selectedFiles = new Set();
+let toastTimer = null;
+let previousTaskFingerprint = "";
+
+function refreshIcons() {
+    if (window.lucide) window.lucide.createIcons({ attrs: { "stroke-width": 1.8 } });
+}
+
+async function api(path, options = {}) {
+    const response = await fetch(path, {
+        ...options,
+        headers: { "Content-Type": "application/json", ...(options.headers || {}) },
+    });
+    if (!response.ok) {
+        let message = `请求失败 (${response.status})`;
+        try { message = (await response.json()).detail || message; } catch (_) { /* no-op */ }
+        throw new Error(message);
+    }
+    return response.status === 204 ? null : response.json();
+}
+
+function showToast(message, error = false) {
+    clearTimeout(toastTimer);
+    elements.toast.textContent = message;
+    elements.toast.className = `toast show${error ? " error" : ""}`;
+    toastTimer = setTimeout(() => { elements.toast.className = "toast"; }, 3200);
+}
+
+function formatBytes(value) {
+    if (!Number.isFinite(value) || value < 0) return "-";
+    if (value < 1024) return `${value} B`;
+    const units = ["KB", "MB", "GB", "TB"];
+    let size = value / 1024;
+    let unit = units[0];
+    for (let i = 1; i < units.length && size >= 1024; i += 1) { size /= 1024; unit = units[i]; }
+    return `${size >= 10 ? size.toFixed(1) : size.toFixed(2)} ${unit}`;
+}
+
+function formatTime(seconds) {
+    return new Intl.DateTimeFormat("zh-CN", {
+        year: "numeric", month: "2-digit", day: "2-digit", hour: "2-digit", minute: "2-digit",
+    }).format(new Date(seconds * 1000));
+}
+
+function taskLabel(state) {
+    return { pending: "等待中", processing: "下载中", success: "已完成", failed: "失败", skipped: "已存在", cancelled: "已取消" }[state] || state;
+}
+
+function taskProgress(task) {
+    const files = (currentState?.files || []).filter((item) => item.task_id === task.task_id);
+    if (!files.length) return { percent: task.state === "success" ? 100 : 0, detail: "等待文件信息" };
+    let completed = 0;
+    let total = 0;
+    let known = true;
+    files.forEach((file) => {
+        completed += file.completed_bytes || 0;
+        if (file.total_bytes) total += file.total_bytes; else known = false;
+    });
+    const percent = task.state === "success" ? 100 : (known && total ? Math.min(100, completed / total * 100) : 0);
+    return { percent, detail: known && total ? `${formatBytes(completed)} / ${formatBytes(total)}` : `${files.length} 个文件` };
+}
+
+function createIconButton(iconName, title, onClick) {
+    const button = document.createElement("button");
+    button.type = "button";
+    button.className = "icon-button subtle";
+    button.title = title;
+    button.setAttribute("aria-label", title);
+    button.innerHTML = `<i data-lucide="${iconName}"></i>`;
+    button.addEventListener("click", onClick);
+    return button;
+}
+
+function renderTasks() {
+    const tasks = currentState?.tasks || [];
+    elements.taskList.replaceChildren();
+    const active = tasks.filter((task) => ["pending", "processing"].includes(task.state)).length;
+    elements.taskSummary.textContent = tasks.length ? `${tasks.length} 个任务，${active} 个进行中` : "暂无任务";
+    if (!tasks.length) {
+        elements.taskList.innerHTML = '<div class="empty-state"><i data-lucide="inbox"></i><span>暂无下载任务</span></div>';
+        refreshIcons();
+        return;
+    }
+    [...tasks].reverse().forEach((task) => {
+        const progress = taskProgress(task);
+        const row = document.createElement("div");
+        row.className = "task-row";
+
+        const name = document.createElement("div");
+        name.className = "task-name";
+        const strong = document.createElement("strong");
+        strong.textContent = task.display_text || task.url;
+        strong.title = task.url;
+        const source = document.createElement("span");
+        source.textContent = task.source === "monitor" ? "剪贴板监听" : "页面提交";
+        name.append(strong, source);
+
+        const progressCell = document.createElement("div");
+        progressCell.className = "task-progress";
+        progressCell.innerHTML = `<div class="progress-track"><div class="progress-bar" style="width:${progress.percent}%"></div></div><span class="progress-meta">${progress.detail}</span>`;
+
+        const state = document.createElement("span");
+        state.className = `state-pill ${task.state}`;
+        state.textContent = taskLabel(task.state);
+
+        const cancel = createIconButton("x", "取消任务", async () => {
+            try { await api(`/api/tasks/${encodeURIComponent(task.task_id)}`, { method: "DELETE" }); await refreshState(); }
+            catch (error) { showToast(error.message, true); }
+        });
+        cancel.disabled = task.state !== "pending";
+        row.append(name, progressCell, state, cancel);
+        elements.taskList.append(row);
+    });
+    refreshIcons();
+}
+
+function filteredLibrary() {
+    const query = elements.fileSearch.value.trim().toLocaleLowerCase();
+    return query ? libraryItems.filter((item) => item.path.toLocaleLowerCase().includes(query)) : libraryItems;
+}
+
+function updateSelection() {
+    const visible = filteredLibrary();
+    const selectedVisible = visible.filter((item) => selectedFiles.has(item.path)).length;
+    elements.selectAllFiles.checked = visible.length > 0 && selectedVisible === visible.length;
+    elements.selectAllFiles.indeterminate = selectedVisible > 0 && selectedVisible < visible.length;
+    elements.archiveButton.disabled = selectedFiles.size === 0;
+    elements.archiveButton.lastChild.textContent = selectedFiles.size ? `打包下载 (${selectedFiles.size})` : "打包下载";
+}
+
+function renderLibrary() {
+    const visible = filteredLibrary();
+    elements.fileList.replaceChildren();
+    const table = elements.fileList.closest("table");
+    table.hidden = visible.length === 0;
+    elements.librarySummary.textContent = `${libraryItems.length} / ${currentState?.libraryTotal ?? libraryItems.length} 个文件`;
+    visible.forEach((item) => {
+        const row = document.createElement("tr");
+        const selectCell = document.createElement("td");
+        selectCell.className = "select-cell";
+        const checkbox = document.createElement("input");
+        checkbox.type = "checkbox";
+        checkbox.checked = selectedFiles.has(item.path);
+        checkbox.setAttribute("aria-label", `选择 ${item.name}`);
+        checkbox.addEventListener("change", () => {
+            if (checkbox.checked) selectedFiles.add(item.path); else selectedFiles.delete(item.path);
+            updateSelection();
+        });
+        selectCell.append(checkbox);
+
+        const name = document.createElement("td");
+        const nameText = document.createElement("div");
+        nameText.className = "file-name";
+        nameText.textContent = item.name;
+        nameText.title = item.path;
+        name.append(nameText);
+
+        const kind = document.createElement("td");
+        kind.className = "file-kind";
+        kind.textContent = item.suffix;
+        const size = document.createElement("td");
+        size.textContent = formatBytes(item.size);
+        const time = document.createElement("td");
+        time.textContent = formatTime(item.modified);
+        const action = document.createElement("td");
+        action.className = "action-cell";
+        const link = document.createElement("a");
+        link.className = "file-download";
+        link.href = item.download_url;
+        link.download = item.name;
+        link.title = "下载文件";
+        link.setAttribute("aria-label", `下载 ${item.name}`);
+        link.innerHTML = '<i data-lucide="download"></i>';
+        action.append(link);
+        row.append(selectCell, name, kind, size, time, action);
+        elements.fileList.append(row);
+    });
+    updateSelection();
+    refreshIcons();
+}
+
+async function refreshState() {
+    try {
+        currentState = await api("/api/state");
+        elements.serviceStatus.className = "service-status online";
+        elements.serviceStatus.querySelector("span").textContent = "服务正常";
+        const settings = currentState.settings || {};
+        elements.downloadRoot.textContent = `${settings.effective_work_path || ""}\\${settings.folder_name || "Download"}`;
+        elements.cookieState.textContent = settings.cookie_configured ? "已配置" : "未配置";
+        if (!currentState.disclaimer_accepted && !elements.disclaimerDialog.open) elements.disclaimerDialog.showModal();
+        renderTasks();
+        const fingerprint = (currentState.tasks || []).map((task) => `${task.task_id}:${task.state}`).join("|");
+        if (fingerprint !== previousTaskFingerprint && /success|skipped/.test(fingerprint)) await refreshLibrary();
+        previousTaskFingerprint = fingerprint;
+    } catch (error) {
+        elements.serviceStatus.className = "service-status error";
+        elements.serviceStatus.querySelector("span").textContent = "服务异常";
+    }
+}
+
+async function refreshLibrary() {
+    try {
+        const result = await api("/api/library?limit=500");
+        libraryItems = result.items;
+        currentState = { ...(currentState || {}), libraryTotal: result.total };
+        selectedFiles = new Set([...selectedFiles].filter((path) => libraryItems.some((item) => item.path === path)));
+        renderLibrary();
+    } catch (error) { showToast(error.message, true); }
+}
+
+async function pasteLink() {
+    try {
+        let content = "";
+        if (navigator.clipboard?.readText) {
+            try { content = await navigator.clipboard.readText(); } catch (_) { /* server fallback */ }
+        }
+        if (!content) content = (await api("/api/clipboard", { method: "POST" })).content;
+        elements.urlInput.value = content || "";
+        elements.urlInput.focus();
+        if (!content) showToast("剪贴板中没有文本", true);
+    } catch (error) { showToast(error.message, true); }
+}
+
+async function createDownload() {
+    const content = elements.urlInput.value.trim();
+    if (!content) { showToast("请先粘贴笔记链接", true); elements.urlInput.focus(); return; }
+    elements.downloadButton.disabled = true;
+    try {
+        const result = await api("/api/tasks", { method: "POST", body: JSON.stringify({ content }) });
+        showToast(`已创建 ${result.tasks.length} 个下载任务`);
+        elements.urlInput.value = "";
+        await refreshState();
+    } catch (error) { showToast(error.message, true); }
+    finally { elements.downloadButton.disabled = false; }
+}
+
+async function downloadArchive() {
+    if (!selectedFiles.size) return;
+    elements.archiveButton.disabled = true;
+    try {
+        const response = await fetch("/api/archive", {
+            method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ paths: [...selectedFiles] }),
+        });
+        if (!response.ok) throw new Error((await response.json()).detail || "打包失败");
+        const url = URL.createObjectURL(await response.blob());
+        const link = document.createElement("a");
+        link.href = url;
+        link.download = "xiaohongshu-download.zip";
+        link.click();
+        URL.revokeObjectURL(url);
+    } catch (error) { showToast(error.message, true); }
+    finally { updateSelection(); }
+}
+
+elements.pasteButton.addEventListener("click", pasteLink);
+elements.clearInputButton.addEventListener("click", () => { elements.urlInput.value = ""; elements.urlInput.focus(); });
+elements.downloadButton.addEventListener("click", createDownload);
+elements.urlInput.addEventListener("keydown", (event) => { if ((event.ctrlKey || event.metaKey) && event.key === "Enter") createDownload(); });
+elements.clearTasksButton.addEventListener("click", async () => { try { await api("/api/tasks", { method: "DELETE" }); await refreshState(); } catch (error) { showToast(error.message, true); } });
+elements.fileSearch.addEventListener("input", renderLibrary);
+elements.refreshLibraryButton.addEventListener("click", refreshLibrary);
+elements.selectAllFiles.addEventListener("change", () => {
+    filteredLibrary().forEach((item) => { if (elements.selectAllFiles.checked) selectedFiles.add(item.path); else selectedFiles.delete(item.path); });
+    renderLibrary();
+});
+elements.archiveButton.addEventListener("click", downloadArchive);
+elements.openFolderButton.addEventListener("click", async () => { try { await api("/api/folder/open", { method: "POST" }); } catch (error) { showToast(error.message, true); } });
+elements.settingsButton.addEventListener("click", () => { elements.cookieInput.value = ""; elements.settingsDialog.showModal(); });
+elements.cookieForm.addEventListener("submit", async (event) => {
+    event.preventDefault();
+    try {
+        const result = await api("/api/settings/cookie", { method: "PUT", body: JSON.stringify({ cookie: elements.cookieInput.value }) });
+        elements.cookieState.textContent = result.cookie_configured ? "已配置" : "未配置";
+        elements.cookieInput.value = "";
+        elements.settingsDialog.close();
+        showToast("Cookie 设置已保存");
+    } catch (error) { showToast(error.message, true); }
+});
+elements.acceptDisclaimerButton.addEventListener("click", async () => {
+    elements.acceptDisclaimerButton.disabled = true;
+    try { await api("/api/disclaimer/accept", { method: "POST" }); elements.disclaimerDialog.close(); await refreshState(); }
+    catch (error) { showToast(error.message, true); }
+    finally { elements.acceptDisclaimerButton.disabled = false; }
+});
+
+refreshIcons();
+Promise.all([refreshState(), refreshLibrary()]).finally(() => {
+    setInterval(refreshState, 1000);
+    setInterval(refreshLibrary, 5000);
+});
